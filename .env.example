# --- General ---
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
# URL que usa el navegador del usuario para llegar al backend (debe ser accesible públicamente,
# no "localhost", salvo que estés probando todo en la misma máquina)
VITE_API_URL=http://localhost:8000

# --- Database ---
POSTGRES_USER=irtax
POSTGRES_PASSWORD=irtax_dev_password
POSTGRES_DB=irtax
DATABASE_URL=postgresql+psycopg://irtax:irtax_dev_password@db:5432/irtax

# --- Redis / jobs ---
REDIS_URL=redis://redis:6379/0

# --- Auth / JWT ---
# Genera uno nuevo con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=changeme_dev_secret_do_not_use_in_production
JWT_COOKIE_NAME=irtax_session
JWT_EXPIRE_MINUTES=10080

# --- Google OAuth (dejar vacío = botón de Google oculto / modo degradado) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Stripe (dejar vacío = checkout deshabilitado / modo degradado) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Storage ---
STORAGE_DIR=/data/storage
FILE_RETENTION_HOURS=24
